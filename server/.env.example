# Server
PORT=5175
CLIENT_ORIGIN=http://localhost:5173

# Database
# Set a real MongoDB connection string for persistent storage.
MONGO_URI=mongodb://127.0.0.1:27017/mota_scholarship
# Set to true to run an in-memory MongoDB (no install needed) — demo / hackathon use only.
USE_MEMORY_DB=false

# Auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
