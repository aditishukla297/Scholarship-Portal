# Server
PORT=5175
CLIENT_ORIGIN=http://localhost:5180

# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/mota_scholarship
# Neon:   postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mota_scholarship
PG_POOL_MAX=5

# Auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# Uploads (held in the database, not on disk)
MAX_UPLOAD_MB=5

# Only needed if your network's DNS resolver refuses to resolve the database host.
# Resolves it through these servers instead. Leave unset in deployment.
# DNS_SERVERS=8.8.8.8,1.1.1.1
